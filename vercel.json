{
  "rewrites": [
    {
      "source": "/s",
      "destination": "/api/s"
    },
    {
      "source": "/rating",
      "destination": "https://cinerating.vercel.app/rating"
    },
    {
      "source": "/rating/:path*",
      "destination": "https://cinerating.vercel.app/rating/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/depth.js": {
      "memory": 1769,
      "maxDuration": 30,
      "excludeFiles": "{node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32}/**,node_modules/@img/sharp-{darwin,win32}-*/**,node_modules/@img/sharp-libvips-{darwin,win32}-*/**}"
    }
  }
}